{#
/**
 * @file
 * pascience theme override for the Recommended Resource (CiDeR) bundle.
 *
 * pascience has no general node.html.twig override (falls back to the
 * Stable base theme's default). This override matches that default markup,
 * but the teaser/embedded title ({{ label }}, used when a resource is
 * referenced from another entity, e.g. an affinity group's
 * field_cider_resources) resolves through resource_display_name so it shows
 * the short name rather than the longer descriptive title. See
 * operations_cider_preprocess_node().
 *
 * Available variables: see Stable's node.html.twig.
 *
 * @see template_preprocess_node()
 */
#}
<article{{ attributes }}>

  {{ title_prefix }}
  {% if not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ resource_display_name }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <footer>
      {{ author_picture }}
      <div{{ author_attributes }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
        {{ metadata }}
      </div>
    </footer>
  {% endif %}

  <div{{ content_attributes }}>
    {{ content }}
  </div>

</article>
