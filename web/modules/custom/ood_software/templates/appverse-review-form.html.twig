{#
/**
 * @file
 * The review page, laid out as the moderation wireframe.
 *
 * Available: form (the render array; form['#page'] is the shaped data and
 * form['#can_edit'] says whether the reviewer controls are present).
 * Class names follow the wireframe so its CSS ports as-is; everything is
 * scoped under .arv-page.
 */
#}
{% set page = form['#page'] %}
{% set can_edit = form['#can_edit'] %}
{# The wireframe's dot classes rate quality: level-high is the good end (solid
   green), level-low the poor end (red ring). #}
{% set level_class = {'solid': 'high', 'some_notes': 'medium', 'needs_attention': 'low'} %}

{% macro level_badge(level, labels, level_class) %}
  {% if level %}
    <span class="rating-badge" title="{{ labels[level] ?? level }}">
      <span class="rating-dot level-{{ level_class[level] ?? 'none' }}"></span>
      <span class="rating-label">{{ labels[level] ?? level }}</span>
    </span>
  {% else %}
    <span class="rating-badge rating-badge--none">{{ 'not rated'|t }}</span>
  {% endif %}
{% endmacro %}

{% macro finding_row(finding, form, can_edit) %}
  <div class="finding">
    <div class="frow">
      <div class="rule">{{ finding.rule }}</div>
      <div>
        <div class="sum">
          {# What changed since the last round is what a reviewer is looking
             for, so the new ones are marked rather than every carried-over
             one being labelled (appverse-planning#54). #}
          {% if finding.is_new %}<span class="finding-new">{{ 'New'|t }}</span> {% endif %}
          {{ finding.summary }}
        </div>
        <div class="ev">{% for part in finding.evidence_parts %}{% if part.url %}<a href="{{ part.url }}" target="_blank" rel="noopener" title="{{ 'View on GitHub at the reviewed commit'|t }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</div>

        {% if finding.source == 'reviewer' %}
          <div class="added-by"><span class="reviewer-tag">{{ 'Reviewer'|t }}</span> {{ 'Added by @name · @when'|t({'@name': finding.author ?: 'a reviewer'|t, '@when': finding.created}) }}</div>
        {% endif %}
      </div>
      {% if can_edit %}
        <div class="frow-actions">
          {% if finding.source == 'reviewer' %}
            <button type="button" class="expand-hint">{{ 'Edit'|t }}</button>
          {% else %}
            <button type="button" class="expand-hint" data-has-note="{{ 'has note'|t }}">{{ '+ add note'|t }}</button>
          {% endif %}
        </div>
      {% endif %}
    </div>
    {% if can_edit %}
      <div class="fnote">
        {{ attribute(form.prose, finding.pid) }}
        {% if finding.source == 'reviewer' %}
          {{ attribute(form.edit_finding, finding.pid) }}
          <div class="finding-delete">{{ attribute(form.delete_finding, finding.pid) }}</div>
        {% endif %}
      </div>
    {% elseif finding.prose %}
      <div class="fnote"><div class="arv-text">{{ finding.prose }}</div></div>
    {% endif %}
  </div>
{% endmacro %}

{% macro catblock(block, form, can_edit, page, level_el, note_el) %}
  {% import _self as m %}
  {# level-changed: the reviewer has moved off the automated rating, so the
     dropdown and the note stay open rather than collapsing behind the icon. #}
  <div class="catblock{% if block.level and block.tool_level and block.level != block.tool_level %} level-changed{% endif %}" id="block-{{ block.key }}">
    <div class="cat-top">
      <div class="cat-title-row">
        <div class="cat-left">
          <span class="cat-name">{{ block.title }}</span>
          {% if block.level is not null or block.key in ['portability', 'documentation', 'maintenance'] %}
            {# The rating reads as a badge and the dropdown stays hidden until
               the edit icon is clicked. It was always an editable control with
               the automated rating captioned under it, which is sidebar
               clutter on the rows nobody is changing (appverse-planning#54).
               Both are rendered: the JS swaps which one is shown, so with no
               JS the dropdown is simply there. #}
            {% if can_edit and level_el %}
              {# Literal map: a macro cannot see the template's level_class. #}
              <span class="level-readonly">{{ m.level_badge(block.level, page.level_labels[block.key] ?? {}, {'solid': 'high', 'some_notes': 'medium', 'needs_attention': 'low'}) }}</span>
              <span class="level-control">{{ level_el }}</span>
            {% else %}
              {{ m.level_badge(block.level, page.level_labels[block.key] ?? {}, {'solid': 'high', 'some_notes': 'medium', 'needs_attention': 'low'}) }}
            {% endif %}
            {% if can_edit and level_el %}
              <button type="button" class="edit-icon-btn" title="{{ 'Change the automated rating'|t }}" aria-label="{{ 'Change the rating for @b'|t({'@b': block.title}) }}"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
            {% endif %}
          {% endif %}
        </div>
        <div class="cat-count">{{ block.count_line }}</div>
      </div>
      {# Like Decision's "Automated suggestion": what the tool rated, and
         whether the reviewer has changed it. #}
      {# Only worth saying once the reviewer has moved off the automated
         rating; otherwise the badge above already is the automated rating
         (appverse-planning#54). #}
      {% if can_edit and level_el and block.tool_level and block.level and block.level != block.tool_level %}
        <div class="concl-caption level-caption">
          {{ 'Changed from automated rating: @l'|t({'@l': (page.level_labels[block.key] ?? {})[block.tool_level] ?? block.tool_level}) }}
        </div>
      {% endif %}
      {% if block.summary %}<div class="cat-summary">{{ block.summary }}</div>{% endif %}
      {% if can_edit and note_el %}
        <div class="override-box">{{ note_el }}</div>
      {% elseif block.note %}
        <div class="override-note">{{ block.note }}</div>
      {% endif %}
      {% if block.gates is not empty %}
        <div class="gates">
          {% for gate in block.gates %}
            <span class="gate gate--{{ gate.value }}" title="{{ gate.label }}: {{ gate.value|replace({'_': ' '}) }}">{{ gate.label }} <b>{{ gate.value|replace({'_': ' '}) }}</b></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% for group in block.groups %}
      <div class="sev-group">
        {# The worst group opens, except info, which starts collapsed even when
           it is the only one: it is the group nobody is reading first
           (appverse-planning#54). #}
        <div class="sev-head{% if loop.first and group.severity != 'info' %} sev-head--open{% endif %}">{{ group.severity|capitalize }} <span class="n">({{ group.count }})</span><span class="car">▸</span></div>
        <div class="sev-body">
          {% for finding in group.findings %}
            {{ m.finding_row(finding, form, can_edit) }}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
    {# PASS and NOT CHECKED rows: not findings, but listed so a reviewer can
       confirm a cleared check. Full page only; the public summary omits them. #}
    {% if block.checked.rows is not empty %}
      {% set parts = [] %}
      {% for result, n in block.checked.counts %}
        {% set parts = parts|merge([n ~ ' ' ~ (result == 'PASS' ? 'passed'|t : (result == 'NOT CHECKED' ? 'not checked'|t : result|lower))]) %}
      {% endfor %}
      <details class="checked-rows">
        <summary>{{ 'Checked: @parts'|t({'@parts': parts|join(' · ')}) }}</summary>
        {% for row in block.checked.rows %}
          <div class="frow">
            <div class="rule">{{ row.rule }}</div>
            <div>
              <div class="sum"><span class="result-pill result-pill--{{ row.result|lower|replace({' ': '-'}) }}">{{ row.result }}</span> {{ row.summary }}</div>
              {% if row.evidence %}<div class="ev">{% if row.evidence_link %}<a href="{{ row.evidence_link.url }}" target="_blank" rel="noopener">{{ row.evidence_link.text }}</a>{{ row.evidence_link.rest }}{% else %}{{ row.evidence }}{% endif %}</div>{% endif %}
            </div>
          </div>
        {% endfor %}
      </details>
    {% endif %}
    {% if can_edit and block.target and form.add_finding[block.target] is defined %}
      <details class="add-finding">
        <summary>{{ '+ Add finding'|t }}</summary>
        {{ attribute(form.add_finding, block.target) }}
      </details>
    {% endif %}
  </div>
{% endmacro %}

{% import _self as m %}

<div class="arv-page">
  {# No <h1> here: the page title block already renders "Review of …". #}
  {% if form['#progress'] %}
    <div class="arv-progress-block">
      {{ form['#progress'] }}

    </div>
  {% endif %}
  {% if page.withdrawn %}
    <div class="arv-superseded">
      {{ 'The contributor withdrew this submission on @at.'|t({'@at': page.withdrawn}) }}
      {% if can_edit %}<span class="arv-superseded-note">{{ 'There is nothing to decide unless they re-submit, which starts a new review.'|t }}</span>{% endif %}
    </div>
  {% endif %}
  {% if page.superseded_by %}
    <div class="arv-superseded">
      {{ 'A newer review of this repo exists'|t }} ({{ page.superseded_by.label }}).
      <a href="{{ page.superseded_by.url }}">{{ 'Go to the newer review'|t }} ›</a>
      {% if can_edit and page.state != 'published' %}<span class="arv-superseded-note">{{ 'This one can still be saved, but not published.'|t }}</span>{% endif %}
    </div>
  {% endif %}
  {# After an Accept with suggestions: publish when the contributor has had a
     chance to act on the suggestions, or right away (appverse-planning#29). #}
  {% if can_edit and page.decision.publish_url %}
    <div class="arv-publish-bar">
      <span>{{ 'Accepted with suggestions. Publish when the contributor has had a chance to act on them, or right away.'|t }}</span>
      <a class="btn primary" href="{{ page.decision.publish_url }}">{{ 'Publish app and review'|t }}</a>
    </div>
  {% endif %}
  <div class="overview-block">
    <div class="overview-row">
      {# Two lines: what was reviewed, then who/when and the links. One long
         line wrapped unevenly. #}
      <div class="overview-meta">
        <div class="overview-line">
          {{ 'Reviewed'|t }} <code>{{ page.sha7 }}</code>{% if page.ref and page.ref != page.sha %} {{ 'on'|t }} <code>{{ page.ref }}</code>{% endif %}
          {% if page.repo_url %} · <a href="{{ page.repo_url }}" target="_blank" rel="noopener">{{ page.repo_url|replace({'https://': ''}) }}</a>{% endif %}
          · {{ page.shape }}
          {# From the same steps the progress line draws, so the two agree.
             This used to show the review node's own moderation state
             (appverse-planning#53). #}
          {% if page.chip %}
            <span class="state-pill state-pill--{{ page.chip.modifier }}">{{ page.chip.label }}</span>
          {% endif %}
        </div>
        <div class="overview-line overview-line--sub">
          {% set sub = [] %}
          {% if page.maintainer %}{% set sub = sub|merge([('Maintainer'|t) ~ ': ' ~ page.maintainer]) %}{% endif %}
          {% if page.reviewed_at %}{% set sub = sub|merge([('Reviewed'|t) ~ ' ' ~ page.reviewed_at]) %}{% endif %}
          {{ sub|join(' · ') }}
          {% if page.tool_version %} · <span class="tool-version">{{ page.tool_version }}</span>{% endif %}
          {% if can_edit %} · <a href="{{ page.public_url }}">{{ 'Public view'|t }}</a>{% endif %}
        </div>
      </div>
      {# The header keeps the position and the rerun note; the reviews
         themselves are listed below it, one line each, rather than as a
         prev/next pair (appverse-planning#54). #}
      <div class="prev-reviews review-history">
        {% if page.history and page.history.total > 1 %}
          <b>{{ 'Review @n of @total'|t({'@n': page.history.position, '@total': page.history.total}) }}</b>
          {% if page.history.is_rerun %}
            · <span class="rerun-note">{{ 'Rerun of the same commit'|t }}</span>
          {% endif %}
        {% else %}
          <span class="muted">{{ 'First review of this repo'|t }}</span>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="layout">
    <div class="main-col">
      {# Step 1 of the Reviewer Process: settle the repo gates and the
         duplicate check. Reviewers and the contributor only; the public
         summary does not render this. #}
      {% if page.repo_gates or page.gate_rows or page.catalog_html %}
        <div class="catblock repo-checks" id="block-repo-checks">
          <div class="cat-top">
            <div class="cat-title-row">
              <span class="cat-name">{{ 'Gates and catalog checks'|t }}</span>
              <div class="cat-count">{{ 'Reviewer Process, step 1'|t }}</div>
            </div>
            {# A row of pills gave a pass the same weight as a failure, and the
               passes are the common case. So the passes read as a count, with
               the names behind a toggle, and anything that is not a pass stays
               out in full (appverse-planning#54). #}
            {# One line per earlier review: decision, date, reviewer, commit. They
         need much less than the review you are reading (appverse-planning#54). #}
      {% if page.history.others is not empty %}
        <details class="other-reviews">
          {% set n = page.history.others|length %}
          {# trans/plural rather than two separate strings, so translators get
             one plural form and languages with other plural rules work. #}
          <summary class="other-reviews__count">{% trans %}{{ n }} other review of this repo{% plural n %}{{ n }} other reviews of this repo{% endtrans %}</summary>
          <ul class="other-reviews__list">
            {% for other in page.history.others %}
              <li>
                <a href="{{ other.url }}">{{ other.at }}</a>
                <code>{{ other.sha7 }}</code>
                {% if other.is_rerun %}<span class="rerun-note">{{ 'rerun'|t }}</span>{% endif %}
                {% if other.decision %}· {{ other.decision }}{% endif %}
                {% if other.reviewer %}· {{ other.reviewer }}{% endif %}
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
      {% if page.round_delta.has_previous and (page.round_delta.new or page.round_delta.resolved) %}
        <div class="round-delta">
          {% if page.round_delta.new %}<span class="round-delta__new">{{ '@n new since the last round'|t({'@n': page.round_delta.new}) }}</span>{% endif %}
          {% if page.round_delta.new and page.round_delta.resolved %} · {% endif %}
          {% if page.round_delta.resolved %}<span class="round-delta__resolved">{{ '@n resolved'|t({'@n': page.round_delta.resolved}) }}</span>{% endif %}
        </div>
      {% endif %}
      {% if page.repo_gate_summary.total %}
              <div class="gates">
                {% if page.repo_gate_summary.passes %}
                  <details class="gate-passes">
                    <summary class="gate-passes__count">
                      {{ '@n of @total gates passed'|t({'@n': page.repo_gate_summary.passed, '@total': page.repo_gate_summary.total}) }}
                    </summary>
                    <div class="gate-passes__list">
                      {% for gate in page.repo_gate_summary.passes %}
                        <span class="gate gate--pass">{{ gate.label }}</span>
                      {% endfor %}
                    </div>
                  </details>
                {% endif %}
                {% for gate in page.repo_gate_summary.others %}
                  <span class="gate gate--{{ gate.value }}">{{ gate.label }} <b>{{ gate.value|replace({'_': ' '}) }}</b></span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
          {% if page.gate_rows %}
            <ul class="gate-rows">
              {% for row in page.gate_rows %}
                <li>
                  <span class="gate-result gate-result--{{ row.result|lower }}">{{ row.result }}</span>
                  {% if row.rule %}<span class="rule">{{ row.rule }}</span>{% endif %}
                  <span class="gate-evidence">{{ row.evidence_html }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if page.catalog_html %}
            <div class="catalog-checks">
              <div class="catalog-checks-title">{{ 'Catalog checks'|t }}</div>
              {{ page.catalog_html }}
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% for app in page.apps %}
        <div class="app-section" id="app-{{ app.app_id }}">
          {% if page.apps|length > 1 %}
            <h2 class="app-name">{{ app.name }} <span class="muted">({{ app.app_id }})</span></h2>
          {% endif %}
          <div class="vbody">
            {% for key, block in app.blocks %}
              {% set level_el = can_edit and key in ['portability', 'documentation'] ? attribute(attribute(form.level, app.pid), key) : null %}
              {% set note_el = can_edit and key in ['portability', 'documentation'] ? attribute(attribute(form.level_note, app.pid), key) : null %}
              {{ m.catblock(block, form, can_edit, page, level_el, note_el) }}
            {% endfor %}
          </div>
        </div>
      {% endfor %}

      <div class="app-section app-section--repo" id="maintenance">
        {% if page.apps|length > 1 %}<h2 class="app-name">{{ 'Repository'|t }}</h2>{% endif %}
        <div class="vbody">
          {% for key, block in page.repo_blocks %}
            {{ m.catblock(block, form, can_edit, page, null, null) }}
          {% endfor %}
          {{ m.catblock(page.maintenance, form, can_edit, page, can_edit ? form.maint_level : null, can_edit ? form.maint_level_note : null) }}
        </div>
      </div>
    </div>

    <aside class="sidebar">
      {# Who reviews the repo, across rounds (appverse-planning#33). #}
      {% if can_edit %}
        <div class="assignee-block">
          <h2 class="sec">{{ 'Reviewer'|t }}</h2>
          {{ form.assignee }}
        </div>
      {% endif %}
      <div class="decision-row">
        <h2 class="sec">{{ 'Decision'|t }}</h2>
      </div>
      {% for app in page.apps %}
        <div class="decision-app">
          {% if page.apps|length > 1 %}<div class="decision-app-name">{{ app.name }}</div>{% endif %}
          {% if can_edit %}
            {{ attribute(form.conclusion, app.pid) }}
          {% else %}
            <div class="decision-value">{{ page.conclusion_labels[app.conclusion] ?? 'Not decided'|t }}</div>
          {% endif %}
        </div>
      {% endfor %}
      {# The tool's suggestion is for reviewers; contributors never see AI
         state (appverse-planning#42). #}
      {% if can_edit and page.recommendation %}
        <div class="concl-caption" title="{{ page.recommendation_note }}">{{ 'Automated suggestion'|t }}: {{ page.recommendation_label }}</div>
      {% endif %}
      <hr class="sidebar-rule">

      <div class="sec-head-row"><h2 class="sec">{{ 'Response to contributor'|t }}</h2></div>
      {% if can_edit %}{{ form.response }}{% else %}<div class="arv-text">{{ page.response }}</div>{% endif %}

      <div class="sec-head-row"><h2 class="sec">{{ 'Reviewer assessment'|t }}</h2></div>
      {% if can_edit %}{{ form.assessment }}{% else %}<div class="arv-text">{{ page.assessment }}</div>{% endif %}

      {% if can_edit %}
        <div class="publish-block">
          <h2 class="sec">{{ page.decision.sent ? 'Decision'|t : 'Save or send the decision'|t }}</h2>
          <div class="publish-note">
            {% if page.decision.sent %}
              <span class="decision-sent">{{ 'Decision sent: @d'|t({'@d': page.decision.label}) }}</span>
              {% if page.decision.by %} · {{ page.decision.by }}{% endif %} · {{ page.decision.at }}
              {% if page.state == 'published' %}<br>{{ 'The review is published.'|t }}{% else %}<br>{{ 'The contributor can read the review and your response; the public cannot.'|t }}{% endif %}
            {% else %}
              {{ 'Visible to reviewers only until a decision is sent. Sending it moves the repo and the review together.'|t }}
            {% endif %}
          </div>
          <div class="publish-row">{{ form.actions }}</div>
        </div>

        <div class="internal-notes-block">
          <h2 class="sec">{{ 'Internal notes'|t }}</h2>
          <p class="notes-help">{{ 'Not visible to the contributor. Log context for other reviewers — conversations, decisions, anything worth remembering if someone else picks this review up.'|t }}</p>
          <div class="note-add">{{ form.new_note }}</div>
          <div class="notes-list">
            {% for note in page.notes %}
              <div class="note-entry">
                <div class="note-meta"><span class="note-name">{{ note.author }}</span><span class="note-date">{{ note.at }}</span></div>
                <div class="note-text">{{ note.text|nl2br }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </aside>
  </div>

  {{ form|without('page', 'can_edit', 'conclusion', 'level', 'level_note', 'prose', 'maint_level', 'maint_level_note', 'response', 'assessment', 'new_note', 'assignee', 'actions', 'add_finding', 'edit_finding', 'delete_finding') }}
</div>
