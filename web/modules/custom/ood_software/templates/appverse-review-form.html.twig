{#
/**
 * @file
 * The review page, laid out as the moderation wireframe.
 *
 * Available: form (the render array; form['#page'] is the shaped data and
 * form['#can_edit'] says whether the reviewer controls are present).
 * Class names follow the wireframe so its CSS ports as-is; everything is
 * scoped under .arv-page.
 */
#}
{% set page = form['#page'] %}
{% set can_edit = form['#can_edit'] %}
{# Reviewer chrome (notes, assignee, Publish, the AI suggestion) shows to
   reviewers even once the decision is sent and the content is read-only
   (the decision-sent view, appverse-planning#56). #}
{% set is_reviewer = form['#is_reviewer'] %}
{# The decisions and the response: editable before sending, and again while a
   sent decision is being updated (appverse-planning#56). #}
{% set can_decide = form['#can_decide'] %}
{# The wireframe's dot classes rate quality: level-high is the good end (solid
   green), level-low the poor end (red ring). #}
{% set level_class = {'solid': 'high', 'some_notes': 'medium', 'needs_attention': 'low'} %}

{% macro level_badge(level, labels, level_class) %}
  {% if level %}
    <span class="rating-badge" title="{{ labels[level] ?? level }}">
      <span class="rating-dot level-{{ level_class[level] ?? 'none' }}"></span>
      <span class="rating-label">{{ labels[level] ?? level }}</span>
    </span>
  {% else %}
    <span class="rating-badge rating-badge--none">{{ 'not rated'|t }}</span>
  {% endif %}
{% endmacro %}

{# One row of a worklist. item is the worklist item the row shows (section,
   floor), or null for a dismissed row, which only carries its section. #}
{% macro finding_row(finding, form, can_edit, item, labels) %}
  {% import _self as m %}
  {% set editable = can_edit and form.save_finding[finding.pid] is defined %}
  {% set section = item.section ?? finding.section ?? '' %}
  <div class="finding" id="finding-{{ finding.pid }}"{% if section %} data-section="{{ section }}"{% endif %}>
    {# What an AJAX save just did here. The announcement already speaks it,
       so this line is hidden from screen readers. #}
    {% set confirm = form['#arv_confirm'] ?? null %}
    {% if confirm and confirm.finding and confirm.finding ~ '' == finding.pid ~ '' %}
      <p class="arv-saved" aria-hidden="true">{{ confirm.text }}</p>
    {% endif %}
    <div class="frow">
      <div class="rule">{{ finding.rule }}</div>
      <div>
        <div class="sum">
          {# What changed since the last round is what a reviewer is looking
             for, so the new ones are marked rather than every carried-over
             one being labelled (appverse-planning#54). #}
          {% if finding.is_new %}<span class="finding-new">{{ 'New'|t }}</span> {% endif %}
          {# The rubric's Reject trigger. Reviewer-only: the contributor gets
             the reviewer's own words, not the tool's suspicion. #}
          {% if can_edit and finding.tag == 'potentially_malicious' %}<span class="finding-malicious">{{ 'Potentially malicious'|t }}</span> {% endif %}
          {{ finding.summary }}
          {% if finding.override and finding.override.edited %} <span class="finding-edited">{{ 'Edited by the reviewer'|t }}</span>{% endif %}
        </div>
        {% if item %}{{ m.item_details(item, labels) }}{% endif %}
        <div class="ev">{% for part in finding.evidence_parts %}{% if part.url %}<a href="{{ part.url }}" target="_blank" rel="noopener" title="{{ 'View on GitHub at the reviewed commit'|t }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</div>

        {# A reviewer's change to the tool's finding (A1). The note below is
           the reason; the tool's own values stay on the record. #}
        {% if finding.override and (finding.dismissed or finding.override.severity) %}
          <div class="override-mark">
            {% if finding.dismissed %}
              {{ 'Dismissed by @name · @when'|t({'@name': finding.override.by ?: 'a reviewer'|t, '@when': finding.override.at}) }}
            {% else %}
              {{ 'Reviewer changed the severity from @severity'|t({'@severity': finding.tool_severity|capitalize}) }}
            {% endif %}
          </div>
        {% endif %}
        {% if finding.prose %}
          <div class="finding-note"><span class="finding-note-label">{{ 'Note'|t }}</span> {{ finding.prose }}</div>
        {% endif %}
        {% if can_edit and finding.original %}
          <details class="finding-original">
            <summary>{{ 'Original wording'|t }}</summary>
            <div>{{ finding.original.summary }}</div>
            <div class="ev">{{ finding.original.evidence }}</div>
          </details>
        {% endif %}

        {% if finding.source == 'reviewer' %}
          <div class="added-by"><span class="reviewer-tag">{{ 'Reviewer'|t }}</span> {{ 'Added by @name · @when'|t({'@name': finding.author ?: 'a reviewer'|t, '@when': finding.created}) }}</div>
        {% endif %}
      </div>
      {% if editable %}
        <div class="frow-actions">
          <button type="button" class="expand-hint" aria-expanded="false">{{ 'Edit'|t }}</button>
          {# Moves the list's add form here, on this row's section. Only the
             script can do that, so it is hidden until the script shows it.
             Not on a dismissed row (no item), which sits in its own fold. #}
          {% if item and section %}
            <button type="button" class="arv-add-here" data-section="{{ section }}" hidden>{{ 'Add a finding here'|t }}</button>
          {% endif %}
        </div>
      {% endif %}
    </div>
    {% if editable %}
      {# The edit box: the finding's fields, the note to the contributor and
         a Save beside it. Starts closed; Cancel puts the fields back. #}
      <div class="fnote">
        {% if form.override[finding.pid] is defined %}
          {{ attribute(form.override, finding.pid) }}
        {% elseif form.edit_finding[finding.pid] is defined %}
          {{ attribute(form.edit_finding, finding.pid) }}
        {% endif %}
        {{ attribute(form.prose, finding.pid) }}
        <div class="fnote-actions">
          {{ attribute(form.save_finding, finding.pid) }}
          <button type="button" class="btn ghost finding-cancel">{{ 'Cancel'|t }}</button>
          {% if form.delete_finding[finding.pid] is defined %}
            <span class="finding-delete">{{ attribute(form.delete_finding, finding.pid) }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
{% endmacro %}

{# The line under an item's summary: its section, and for a blocking item
   the mildest decision it allows, with the reason on hover. #}
{% macro item_details(item, labels) %}
  <div class="arv-item-details">
    <span>{{ item.section_title }}</span>
    {%- if item.blocking %}<span class="arv-sep" aria-hidden="true"> · </span><span class="arv-floor" title="{{ item.blocking.reason }}">{{ 'At least @d'|t({'@d': labels[item.blocking.decision] ?? item.blocking.decision}) }}</span>{% endif -%}
  </div>
{% endmacro %}

{# A check that is not a finding: a gate, a catalog check, or a passed row.
   Its result as a label, then what it is. No controls. #}
{% macro check_row(row, can_edit) %}
  {% set result = row.result ?? (row.value ?? '')|upper|replace({'_': ' '}) %}
  <div class="frow">
    <div class="rule">{{ row.rule ?? '' }}</div>
    <div>
      <div class="sum">
        <span class="result-pill result-pill--{{ result|lower|replace({' ': '-', '/': ''}) }}">{{ result }}</span>
        {% if row.check is defined %}
          <span class="catalog-check">{{ row.check|t }}</span> {{ row.text -}}
          {%- if row.links %}: {% for link in row.links %}{% if link.url %}<a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.title }}</a>{% else %}{{ link.title }}{% endif %}{{ not loop.last ? ', ' }}{% endfor %}{% endif -%}
          {%- if row.add_software and can_edit %} · <a href="{{ path('node.add', {'node_type': 'appverse_software'}) }}" target="_blank" rel="noopener">{{ 'Add the Software entry'|t }}</a>{% endif -%}
        {% else %}
          {{ row.summary ?? row.label ?? '' }}
        {% endif %}
      </div>
      {% if row.evidence is defined and row.evidence %}<div class="ev">{% if row.evidence_link %}<a href="{{ row.evidence_link.url }}" target="_blank" rel="noopener">{{ row.evidence_link.text }}</a>{{ row.evidence_link.rest }}{% else %}{{ row.evidence }}{% endif %}</div>{% endif %}
    </div>
  </div>
{% endmacro %}

{# The duplicate check's line: what the check compared against and found
   (ReviewPageData::duplicateBasis()). With nothing to go on, "catalog"
   links to the catalog. #}
{% macro duplicate_line(mode, line, catalog_url) %}
  {%- if mode == 'unknown' and ' catalog ' in line -%}
    {%- set parts = line|split(' catalog ', 2) -%}
    {{ parts[0] }} <a href="{{ catalog_url }}" target="_blank" rel="noopener">{{ 'catalog'|t }}</a> {{ parts[1] }}
  {%- else -%}
    {{ line }}
  {%- endif -%}
{% endmacro %}

{# The other published apps a duplicate check compares against. #}
{% macro duplicate_apps(apps) %}
  {%- if apps -%}
    <ul class="duplicate-apps">
      {%- for link in apps -%}
        <li>{% if link.url %}<a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.title }}</a>{% else %}{{ link.title }}{% endif %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{% endmacro %}

{# A duplicate check's radios and note. Behind Change when the check has
   an outcome or a one-click Confirm; open otherwise, and without JS. #}
{% macro duplicate_fields(control, pid, toggle) %}
  <div class="duplicate-fields" id="duplicate-fields-{{ pid }}"{% if toggle %} data-duplicate-toggle{% endif %}>
    {{ control.outcome }}
    {{ control.note }}
  </div>
{% endmacro %}

{# One worklist item. A finding is the full row with its controls; a
   reference points at an every-app blocker listed in another list; a
   duplicate check left to the reviewer carries its control; a gate or
   catalog check is a row with no controls. #}
{% macro worklist_item(item, form, can_edit, labels) %}
  {% import _self as m %}
  {% if item.kind == 'finding' %}
    {{ m.finding_row(item.row, form, can_edit, item, labels) }}
  {% elseif item.kind == 'duplicate' %}
    <div class="finding finding--duplicate duplicate-check-block" id="duplicate-{{ item.row.pid }}" data-section="{{ item.section }}">
      <div class="duplicate-line"><span class="duplicate-label">{{ 'Duplicate check:'|t }}</span> {{ m.duplicate_line(item.row.mode, item.row.line, form['#page'].catalog_url) }}</div>
      {{ m.duplicate_apps(item.row.apps) }}
      {% if form.duplicate[item.row.pid] is defined %}
        {{ m.duplicate_fields(attribute(form.duplicate, item.row.pid), item.row.pid, false) }}
      {% endif %}
    </div>
  {% elseif item.kind == 'reference' %}
    <div class="finding finding--reference" data-section="{{ item.section }}">
      <div class="frow">
        {# Two or more from the same list read as one row (ReviewWorklist),
           linking to the most severe. #}
        {% if item.row.count > 1 %}
          <div class="rule"></div>
          <div>
            <div class="sum"><a href="#finding-{{ item.row.pid }}">{{ '@n blocking findings in @source apply to every app'|t({'@n': item.row.count, '@source': item.row.source_title}) }}</a></div>
        {% else %}
          <div class="rule">{{ item.row.rule }}</div>
          <div>
            <div class="sum"><a href="#finding-{{ item.row.pid }}">{{ item.row.summary }}</a><span class="arv-sep" aria-hidden="true"> · </span>{{ 'Blocks every app'|t }}<span class="arv-sep" aria-hidden="true"> · </span>{{ 'in @app'|t({'@app': item.row.app_title}) }}</div>
        {% endif %}
          {{ m.item_details(item, labels) }}
        </div>
      </div>
    </div>
  {% else %}
    <div class="finding finding--check" data-section="{{ item.section }}">
      {{ m.check_row(item.row, can_edit) }}
      <div class="arv-check-details">{{ m.item_details(item, labels) }}</div>
    </div>
  {% endif %}
{% endmacro %}

{# The anchors of the sections whose first item is at index (null: the
   sections with no items). The catalog and the signals deep-link to them
   (ReviewSignals): block-<app id>-<section>, or block-<section> for the
   repo. #}
{% macro section_anchors(list, index) %}
  {% for s in list.sections %}
    {% if s.first is same as(index) %}<span class="arv-anchor" id="block-{{ list.scope ? list.scope ~ '-' : '' }}{{ s.key }}"></span>{% endif %}
  {% endfor %}
{% endmacro %}

{# One rating: the badge, the edit icon that swaps in the dropdown and the
   note, and the axis summary under it. #}
{% macro rating(block, labels, level_el, note_el, can_edit) %}
  {% import _self as m %}
  {# Literal map: a macro cannot see the template's level_class. #}
  {% set classes = {'solid': 'high', 'some_notes': 'medium', 'needs_attention': 'low'} %}
  {# level-changed: the reviewer has moved off the automated rating, so the
     dropdown and the note stay open rather than collapsing behind the icon. #}
  {% set changed = block.level and block.tool_level and block.level != block.tool_level %}
  <div class="arv-rating{% if changed %} level-changed{% endif %}">
    <div class="arv-rating__head">
      <span class="arv-rating__name">{{ block.title }}</span>
      {# Both are rendered: the script swaps which one shows, so with no
         script the dropdown is simply there (appverse-planning#54). #}
      {% if can_edit and level_el %}
        <span class="level-readonly">{{ m.level_badge(block.level, labels, classes) }}</span>
        <span class="level-control">{{ level_el }}</span>
        <button type="button" class="edit-icon-btn" title="{{ 'Change the automated rating'|t }}" aria-label="{{ 'Change the rating for @b'|t({'@b': block.title}) }}"><i class="bi bi-pencil" aria-hidden="true"></i></button>
      {% else %}
        {{ m.level_badge(block.level, labels, classes) }}
      {% endif %}
    </div>
    {% if can_edit and level_el and changed %}
      <div class="concl-caption level-caption">
        {{ 'Changed from automated rating: @l'|t({'@l': labels[block.tool_level] ?? block.tool_level}) }}
      </div>
    {% endif %}
    {% if can_edit and note_el %}
      <div class="override-box">{{ note_el }}</div>
    {% endif %}
    {% if block.summary %}<div class="arv-rating__summary">{{ block.summary }}</div>{% endif %}
    {% if not (can_edit and note_el) and block.note %}
      <div class="override-note">{{ block.note }}</div>
    {% endif %}
  </div>
{% endmacro %}

{% import _self as m %}

<div class="arv-page">
  {# No <h1> here: the page title block already renders "Review of …". #}
  {% if page.withdrawn %}
    <div class="arv-superseded">
      {{ 'The contributor withdrew this submission on @at.'|t({'@at': page.withdrawn}) }}
      {% if is_reviewer %}<span class="arv-superseded-note">{{ 'There is nothing to decide unless they re-submit, which starts a new review.'|t }}</span>{% endif %}
    </div>
  {% endif %}
  {% if page.superseded_by %}
    <div class="arv-superseded">
      {{ 'A newer review of this repo exists'|t }} ({{ page.superseded_by.label }}).
      <a href="{{ page.superseded_by.url }}">{{ 'Go to the newer review'|t }} ›</a>
      {% if can_edit and page.state != 'published' %}<span class="arv-superseded-note">{{ 'This one can still be saved, but not published.'|t }}</span>{% endif %}
    </div>
  {% endif %}
  {# After an Accept with suggestions: publish when the contributor has had a
     chance to act on the suggestions, or right away (appverse-planning#29). #}
  {% if is_reviewer and page.decision.publish_url %}
    <div class="arv-publish-bar">
      <span>{{ 'Accepted with suggestions. Publish when the contributor has had a chance to act on them, or right away.'|t }}</span>
      <a class="btn primary" href="{{ page.decision.publish_url }}">{{ 'Publish app and review'|t }}</a>
    </div>
  {% endif %}
  <div class="overview-block">
    <div class="overview-row">
      {# What was reviewed (the app, who sent it, what shape), then this
         review (commit, date, position), then the links out. The model and
         the tool build are in the footer: they matter when a finding looks
         wrong, not in the header. #}
      <div class="overview-meta">
        <h2 class="overview-title">{{ page.title }}</h2>
        <div class="overview-line overview-facts">
          {% if page.repo_url %}
            <a href="{{ page.repo_url }}" target="_blank" rel="noopener">{{ page.repo_url|replace({'https://': '', 'http://': '', 'github.com/': ''}) }}</a>
          {% endif %}
          {% if page.contributor %}
            <span class="overview-sep" aria-hidden="true">·</span>
            {{ 'Submitted by'|t }} <a href="{{ page.contributor.url }}">{{ page.contributor.name }}</a>
          {% endif %}
          {% if page.show_maintainer %}
            <span class="overview-sep" aria-hidden="true">·</span>
            {{ 'Maintained by @m'|t({'@m': page.maintainer}) }}
          {% endif %}
          {% if page.shape %}
            <span class="overview-sep" aria-hidden="true">·</span>
            {{ page.shape }}
          {% endif %}
        </div>
        <div class="overview-line overview-line--sub">
          <code>{{ page.sha7 }}</code>{% if page.ref and page.ref != page.sha %} {{ 'on'|t }} <code>{{ page.ref }}</code>{% endif %}
          {% if page.reviewed_at %}<span class="overview-sep" aria-hidden="true">·</span>{{ page.reviewed_at }}{% endif %}
          <span class="overview-sep" aria-hidden="true">·</span>
          {% if page.history and page.history.total > 1 %}
            <b>{{ 'Review @n of @total'|t({'@n': page.history.position, '@total': page.history.total}) }}</b>{% if page.history.is_rerun %}{{ ', rerun of the same commit'|t }}{% endif %}
          {% else %}
            {{ 'First review of this repo'|t }}{% if page.history.is_rerun %}{{ ', rerun of the same commit'|t }}{% endif %}
          {% endif %}
        </div>
        {# Go to the repo and its apps. Past three apps they collapse into one
           dropdown, as the hub card's Actions menu is built. #}
        {% if page.repo_link or page.app_links or is_reviewer %}
          <div class="arv-go-links">
            {% if page.repo_link %}
              <a href="{{ page.repo_link.url }}"><svg class="arv-go-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg>{{ page.repo_link.label }}</a>
            {% endif %}
            {% if page.app_links|length > 3 %}
              <div class="dropdown arv-go-menu">
                <button class="dropdown-toggle" type="button" id="arv-apps-{{ page.nid }}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><svg class="arv-go-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M4 9h16"></path></svg>{{ 'Apps'|t }}</button>
                <div class="dropdown-menu" aria-labelledby="arv-apps-{{ page.nid }}">
                  {% for app in page.app_links %}<a class="dropdown-item" href="{{ app.url }}">{{ app.label }}</a>{% endfor %}
                </div>
              </div>
            {% else %}
              {% for app in page.app_links %}<a href="{{ app.url }}"{% if page.app_links|length > 1 %} title="{{ app.label }}"{% endif %}><svg class="arv-go-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M4 9h16"></path></svg>{{ page.app_links|length > 1 ? 'View app: @app'|t({'@app': app.label}) : 'View app'|t }}</a>{% endfor %}
            {% endif %}
            {% if is_reviewer %}
              <a href="{{ page.public_url }}"><svg class="arv-go-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>{{ 'Public view'|t }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {# Reviewer only. The button is rendered hidden while a run is in flight,
         and the status line is the poller's target (D8-2931). #}
      {% if is_reviewer and (page.rerun or page.run_status) %}
        <div class="arv-recheck-box review-history">
          {% if page.rerun %}
            <a class="arv-recheck" href="{{ page.rerun.url }}" data-review-rerun aria-label="{{ 'Recheck: run the automated check again on this commit'|t }}"{% if not page.rerun.show %} hidden{% endif %}><svg class="arv-go-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.7"></path><path d="M20 4v5h-5"></path></svg>{{ 'Recheck'|t }}</a>
          {% endif %}
          {% if page.run_status %}
            <div class="arv-run-status" data-review-run-status role="status" aria-live="polite">{% if page.run_status.in_flight %}{{ page.run_status.label }}{% endif %}</div>
            <div><a href="#" data-review-new hidden>{{ 'New report ready, open it'|t }}</a></div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
  {% if form['#progress'] %}
    <div class="arv-progress-block">
      {{ form['#progress'] }}

    </div>
  {% endif %}

  <div class="layout">
    <div class="main-col">
      {# One line per earlier review: decision, date, reviewer, commit. They
         need much less than the review you are reading (appverse-planning#54). #}
      {% if page.history.others is not empty %}
        <details class="other-reviews">
          {% set n = page.history.others|length %}
          {# trans/plural rather than two separate strings, so translators get
             one plural form and languages with other plural rules work. #}
          <summary class="other-reviews__count">{% trans %}{{ n }} other review of this repo{% plural n %}{{ n }} other reviews of this repo{% endtrans %}</summary>
          <ul class="other-reviews__list">
            {% for other in page.history.others %}
              <li>
                <a href="{{ other.url }}">{{ other.at }}</a>
                <code>{{ other.sha7 }}</code>
                {% if other.is_rerun %}<span class="rerun-note">{{ 'rerun'|t }}</span>{% endif %}
                {% if other.decision %}· {{ other.decision }}{% endif %}
                {% if other.reviewer %}· {{ other.reviewer }}{% endif %}
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
      {% if page.round_delta.has_previous and page.compared_position %}
        <div class="round-delta">
          {{ 'Compared with review @n:'|t({'@n': page.compared_position}) }}
          {{ '@new new'|t({'@new': page.round_delta.new}) }} · {{ '@resolved resolved'|t({'@resolved': page.round_delta.resolved}) }}{% if page.model_changed %} · {{ 'different model'|t }}{% endif %}
        </div>
      {% endif %}
      {# The worklists (ReviewWorklist): the repo's first, then one per app.
         Blocking items lead and never fold; passes, dismissals and the add
         form fold below. #}
      {% for list in form['#worklist'] ?? [] %}
        {% set app = list.key == 'repo' ? null : page.apps|filter(a => a.pid ~ '' == list.pid ~ '')|first %}
        <section class="arv-worklist app-section" id="worklist-{{ list.key }}">
          <span class="arv-anchor" id="{{ list.anchor }}"></span>
          <h2 class="app-name">{{ app ? app.name : 'Repository'|t }}</h2>
          <div class="arv-ratings">
            {% if app %}
              {% for axis in ['portability', 'documentation'] %}
                {{ m.rating(app.blocks[axis], page.level_labels[axis] ?? {}, can_edit ? attribute(attribute(form.level, app.pid), axis) : null, can_edit ? attribute(attribute(form.level_note, app.pid), axis) : null, can_edit) }}
              {% endfor %}
            {% else %}
              {{ m.rating(page.maintenance, page.level_labels.maintenance ?? {}, can_edit ? form.maint_level : null, can_edit ? form.maint_level_note : null, can_edit) }}
            {% endif %}
          </div>
          {# The reviewer's duplicate check for this app (A4). Required to
             accept the app. One the reviewer has to look at is a worklist
             item instead (ReviewWorklist::duplicateIsItem()). No whitespace
             when there is nothing in it, so :empty hides it. #}
          {% if app and not app.duplicate.in_worklist %}
            {% set dup = app.duplicate %}
            {% set control = (can_edit or form['#updating']) and form.duplicate[app.pid] is defined ? attribute(form.duplicate, app.pid) : null %}
            <div class="duplicate-check-block" id="duplicate-{{ app.pid }}">
              {%- if dup.outcome -%}
                <div class="duplicate-line"><span class="duplicate-label">{{ 'Duplicate check:'|t }}</span> {{ dup.label }}
                  {%- if control %} <button type="button" class="btn ghost duplicate-change" aria-expanded="true" aria-controls="duplicate-fields-{{ app.pid }}" hidden>{{ 'Change'|t }}</button>{% endif -%}
                </div>
                {% if dup.note %}<div class="finding-note"><span class="finding-note-label">{{ 'Rationale'|t }}</span> {{ dup.note }}</div>{% endif %}
                {%- if control -%}
                  {{ m.duplicate_fields(control, app.pid, true) }}
                {%- endif -%}
              {%- elseif dup.basis.mode == 'legacy' -%}
                {%- if control -%}{{ control }}{%- endif -%}
              {%- else -%}
                <div class="duplicate-line"><span class="duplicate-label">{{ 'Duplicate check:'|t }}</span> {{ m.duplicate_line(dup.basis.mode, dup.basis.line, page.catalog_url) }}</div>
                {{ m.duplicate_apps(dup.basis.apps) }}
                {%- if control -%}
                  <div class="duplicate-actions">
                    {{ control.confirm }}
                    <button type="button" class="btn ghost duplicate-change" aria-expanded="true" aria-controls="duplicate-fields-{{ app.pid }}" hidden>{{ 'Change'|t }}</button>
                  </div>
                  {{ m.duplicate_fields(control, app.pid, true) }}
                {%- endif -%}
              {%- endif -%}
            </div>
          {% endif %}

          {% set blocking = list.items|filter(i => i.blocks) %}
          {% if blocking is not empty %}
            <h3 class="arv-worklist__heading">{{ 'Blocking'|t }}</h3>
            {% for i, item in list.items %}
              {% if item.blocks %}
                {{ m.section_anchors(list, i) }}
                {{ m.worklist_item(item, form, can_edit, page.conclusion_labels) }}
              {% endif %}
            {% endfor %}
          {% endif %}
          <h3 class="arv-worklist__heading">{{ 'Findings'|t }}</h3>
          {% if list.items|length == blocking|length %}
            <p class="arv-worklist__none">{{ blocking is empty ? 'No findings'|t : 'No other findings'|t }}</p>
          {% endif %}
          {% for i, item in list.items %}
            {% if not item.blocks %}
              {{ m.section_anchors(list, i) }}
              {{ m.worklist_item(item, form, can_edit, page.conclusion_labels) }}
            {% endif %}
          {% endfor %}

          {{ m.section_anchors(list, null) }}
          {% if list.passed is not empty %}
            <details class="checked-rows" id="fold-{{ list.key }}-passed">
              <summary>{{ 'Passed checks'|t }}</summary>
              {% for entry in list.passed %}
                <details class="arv-passed">
                  <summary>{{ entry.line }}</summary>
                  {% for row in entry.rows %}
                    {{ m.check_row(row, can_edit) }}
                  {% endfor %}
                </details>
              {% endfor %}
            </details>
          {% endif %}
          {# What the tool recorded for the repo gates, failures included, and
             an older review's catalog checks text. The repo's, so its list
             carries it. #}
          {% set gates = not app ? page.repo_gate_block : null %}
          {% if gates and (gates.rows or gates.catalog_html or gates.catalog_read) %}
            <details class="checked-rows" id="fold-repo-evidence">
              <summary>{{ 'Tool evidence'|t }}</summary>
              {% if gates.rows %}
                <ul class="gate-rows">
                  {% for row in gates.rows %}
                    <li>
                      <span class="gate-result gate-result--{{ row.result|lower }}">{{ row.result }}</span>
                      {% if row.rule %}<span class="rule">{{ row.rule }}</span>{% endif %}
                      <span class="gate-evidence">{{ row.evidence_html }}</span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
              {% if gates.catalog_html or gates.catalog_read %}
                <div class="catalog-checks">
                  <div class="catalog-checks-title">{{ 'Catalog checks'|t }}</div>
                  {% if gates.catalog_read %}<div class="catalog-read">{{ gates.catalog_read }}</div>{% endif %}
                  {{ gates.catalog_html }}
                </div>
              {% endif %}
            </details>
          {% endif %}
          {# The tool's findings the reviewer dismissed (A1): out of the list,
             here with the reason. The public summary leaves them out. #}
          {% if list.dismissed is not empty %}
            <details class="dismissed-rows" id="fold-{{ list.key }}-dismissed">
              <summary>{{ 'Dismissed by the reviewer (@n)'|t({'@n': list.dismissed|length}) }}</summary>
              {% for finding in list.dismissed %}
                {{ m.finding_row(finding, form, can_edit, null, page.conclusion_labels) }}
              {% endfor %}
            </details>
          {% endif %}
          {% set confirm = form['#arv_confirm'] ?? null %}
          {% if confirm and confirm.list and confirm.list == list.key %}
            <p class="arv-saved" aria-hidden="true">{{ confirm.text }}</p>
          {% endif %}
          {% if can_edit and form.add_finding[list.key] is defined %}
            <details class="add-finding" id="fold-{{ list.key }}-add">
              <summary>{{ '+ Add finding'|t }}</summary>
              {{ attribute(form.add_finding, list.key) }}
            </details>
          {% endif %}
        </section>
      {% endfor %}
    </div>

    <aside class="sidebar">
      {# Once sent: the decision, who it waits on and the email as sent
         (appverse-planning#56). #}
      {% if is_reviewer and page.decision.sent %}
        <div class="decision-sent-panel">
          <h2 class="sec">{{ 'Decision sent'|t }}</h2>
          <p class="decision-sent-line">
            <span class="decision-sent">{{ page.decision.label }}</span>
            {% if page.decision.by %} · {{ page.decision.by }}{% endif %} · {{ page.decision.at }}
          </p>
          {% if page.decision.updated_from %}<p class="decision-updated muted">{{ page.decision.updated_from }}</p>{% endif %}
          <p class="decision-waiting">{{ page.decision.waiting_on }}</p>
          {% if form['#updating'] %}
            <p class="decision-updating"><strong>{{ 'Updating the decision.'|t }}</strong> {{ 'Change the decisions or the response below; nothing changes until you confirm, and the contributor is told it replaces the one sent.'|t }}</p>
          {% endif %}
          {% if page.decision.email %}
            <details class="decision-email" open>
              <summary>{{ 'The email as sent'|t }}</summary>
              <div class="email-head">
                <div><span class="muted">{{ 'To'|t }}:</span> {{ page.decision.to }}</div>
                <div><span class="muted">{{ 'Subject'|t }}:</span> {{ page.decision.email.subject }}</div>
              </div>
              <div class="email-body">{{ page.decision.email.html }}</div>
            </details>
          {% endif %}
        </div>
      {% endif %}
      {# Who reviews the repo, across rounds (appverse-planning#33). #}
      {% if is_reviewer %}
        <div class="assignee-block">
          <h2 class="sec">{{ 'Reviewer'|t }}</h2>
          {{ form.assignee }}
        </div>
      {% endif %}
      <div class="decision-row">
        <h2 class="sec">{{ 'Decision'|t }}</h2>
      </div>
      {% for app in page.apps %}
        <div class="decision-app">
          {% if page.apps|length > 1 %}<div class="decision-app-name">{{ app.name }}</div>{% endif %}
          {% if can_decide %}
            {{ attribute(form.conclusion, app.pid) }}
          {% else %}
            <div class="decision-value">{{ page.conclusion_labels[app.conclusion] ?? 'Not decided'|t }}</div>
          {% endif %}
        </div>
      {% endfor %}
      {# The tool's suggestion is for reviewers; contributors never see AI
         state (appverse-planning#42). Only once a decision differs from it:
         while they agree the caption repeats the value right above it
         (appverse-planning#53). #}
      {% if is_reviewer and page.recommendation and page.recommendation_differs %}
        <div class="concl-caption" title="{{ page.recommendation_note }}">{{ 'Changed from the automated suggestion: @s'|t({'@s': page.recommendation_label}) }}</div>
      {% endif %}
      {# The two things the reviewer writes, each under a black bar: one goes
         to the contributor, the other goes public, and the bar is what tells
         them apart at a glance. No rules between sections; the bars do that
         work now (appverse-planning#53). #}
      <div class="sidebar-bar"><h2 class="sec">{{ 'Email to Contributor'|t }}</h2></div>
      {% if can_decide %}{{ form.response }}{% else %}<div class="arv-text">{{ page.response }}</div>{% endif %}

      <div class="sidebar-bar"><h2 class="sec">{{ 'Public Summary'|t }}</h2></div>
      {% if can_edit %}{{ form.assessment }}{% else %}<div class="arv-text">{{ page.assessment }}</div>{% endif %}

      {% if is_reviewer %}
        <div class="publish-block">
          {% if page.decision.sent %}
            <div class="publish-note">
              {{ page.state == 'published' ? 'Published.'|t : 'The contributor can read this; the public cannot.'|t }}
            </div>
          {% else %}
            <h2 class="sec">{{ 'Finish Review'|t }}</h2>
            {# One sentence, under the heading and about the buttons below it.
               It used to open with what the Public Summary does, which
               belongs to that field's own bar above, and close with a second
               line under the buttons, so the block explained two other things
               and nothing about itself. There is no opt-out on the email:
               sending the decision sends it, and the next screen is its
               preview (appverse-planning#53). #}
            <div class="publish-note">
              {{ can_decide
                ? 'Save your work, or send the decision. Sending opens a preview of the email first.'|t
                : 'Save your work on this review.'|t }}
            </div>
          {% endif %}
          <div class="publish-row">{{ form.actions }}</div>
        </div>

        <div class="internal-notes-block">
          <h2 class="sec">{{ 'Internal notes'|t }}</h2>
          <p class="notes-help">{{ 'Reviewers only. Leave context for whoever picks this up next.'|t }}</p>
          <div class="note-add">{{ form.new_note }}</div>
          <div class="notes-list">
            {% for note in page.notes %}
              <div class="note-entry">
                <div class="note-meta"><span class="note-name">{{ note.author }}</span><span class="note-date">{{ note.at }}</span></div>
                <div class="note-text">{{ note.text|nl2br }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </aside>
  </div>

  {{ form|without('page', 'can_edit', 'conclusion', 'level', 'level_note', 'prose', 'maint_level', 'maint_level_note', 'response', 'assessment', 'new_note', 'assignee', 'actions', 'add_finding', 'edit_finding', 'delete_finding', 'override', 'save_finding', 'duplicate') }}

  {# Which build of the tool and which model wrote this report. It matters
     when a finding looks wrong and someone is working out whether the tool
     has changed since, which is not often enough to earn a place in the
     header. #}
  {% if page.tool_version or page.model %}
    <p class="arv-footnote">{% if page.tool_version %}{{ 'Report by appverse-review @tool'|t({'@tool': page.tool_version|replace({'appverse-review@': ''})}) }}{% else %}{{ 'Report'|t }}{% endif %}{% if page.model %} {{ 'using'|t }} <span title="{{ page.model_full }}">{{ page.model }}</span>{% endif %}{% if page.reviewed_at %}, {{ page.reviewed_at }}{% endif %}</p>
  {% endif %}
</div>
