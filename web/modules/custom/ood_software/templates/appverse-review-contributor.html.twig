{#
/**
 * @file
 * The contributor's page of a review: the repo owner's view.
 *
 * Available: form (the render array). form['#contributor_view'] is what
 * ContributorReviewView::build() returns for this review, plus next_step (the
 * sentence for the contributor's steps), decision_apps, decision_key and resubmit (NULL, or
 * {url} of the CSRF-tokened send-for-review route).
 * form['#page'] is the same page data the reviewer's template gets, but only
 * its header facts, decision label and history are read here. The reviewer-only
 * parts of page.decision (publish_url, update_blocker, waiting_on, email) are
 * never printed.
 */
#}
{% set page = form['#page'] %}
{% set view = form['#contributor_view'] %}

{% macro findings(items, multi_app) %}
  <ul class="arv-contributor__findings">
    {% for finding in items %}
      <li class="arv-contributor__finding">
        <span class="arv-contributor__sev arv-contributor__sev--{{ finding.severity|clean_class }}">{{ finding.severity|capitalize }}</span>
        <div class="arv-contributor__finding-body">
          <span class="arv-contributor__summary">{{ finding.summary }}</span>
          <span class="arv-contributor__details">
            {% if multi_app and finding.app %}<span>{{ finding.app }}</span><span aria-hidden="true" class="arv-contributor__dot">·</span>{% endif %}
            <span>{{ finding.section }}</span>
            {% if finding.source == 'reviewer' %}<span aria-hidden="true" class="arv-contributor__dot">·</span><span>{{ 'Added by reviewer'|t }}</span>{% endif %}
            {% if finding.url or finding.file %}
              <span aria-hidden="true" class="arv-contributor__dot">·</span>
              {% set where = finding.file ? (finding.line ? finding.file ~ ':' ~ finding.line : finding.file) : 'View on GitHub'|t %}
              {% if finding.url %}<a href="{{ finding.url }}" target="_blank" rel="noopener"><code>{{ where }}</code></a>{% else %}<code>{{ where }}</code>{% endif %}
            {% endif %}
          </span>
          {% if finding.note %}<p class="arv-contributor__note">{{ finding.note }}</p>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% endmacro %}
{% macro passed(checks) %}
  {% if checks %}
    <details>
      <summary>{{ 'Passed checks (@n)'|t({'@n': checks|length}) }}</summary>
      <ul class="arv-contributor__passed">
        {% for check in checks %}
          <li>{{ check.label }} <span class="arv-contributor__details">{{ check.section }}</span></li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
{% endmacro %}
{% import _self as m %}

<div class="arv-page arv-contributor">
  {# A closed review says so above everything else. #}
  {% if view.closed == 'superseded' and page.superseded_by %}
    <p class="arv-contributor__closed">{{ 'A newer review replaced this one.'|t }} <a href="{{ page.superseded_by.url }}">{{ 'Go to the newer review'|t }}</a></p>
  {% elseif view.closed == 'withdrawn' %}
    <p class="arv-contributor__closed">{{ 'This repo was withdrawn from review.'|t }}</p>
  {% endif %}

  {# What was reviewed, and when: submitted until the decision is sent, then
     who reviewed it. Only values already on the page. #}
  <p class="arv-contributor__meta">
    {% if page.repo_url %}<a href="{{ page.repo_url }}" target="_blank" rel="noopener">{{ page.repo_url|replace({'https://': '', 'github.com/': ''}) }}</a>{% endif %}
    {% if page.sha7 %}<span aria-hidden="true" class="arv-contributor__dot">·</span> <code>{{ page.sha7 }}</code>{% if page.ref and page.ref != page.sha %} {{ 'on'|t }} <code>{{ page.ref }}</code>{% endif %}{% endif %}
    {% if view.state == 'decided' and page.decision.by %}
      <span aria-hidden="true" class="arv-contributor__dot">·</span> {{ 'Reviewed by @name, @date'|t({'@name': page.decision.by, '@date': page.decision.at}) }}
    {% elseif page.reviewed_at %}
      <span aria-hidden="true" class="arv-contributor__dot">·</span> {{ 'Checked @date'|t({'@date': page.reviewed_at}) }}
    {% endif %}
  </p>

  {% if view.state != 'decided' %}
    {% if form['#progress'] %}<div class="arv-contributor__progress">{{ form['#progress'] }}</div>{% endif %}
  {% endif %}

  {% if view.state == 'precheck' %}
    <section class="arv-contributor__section" aria-labelledby="arv-precheck-h">
      <div class="arv-contributor__heading">
        <h2 id="arv-precheck-h">{{ 'Automated check'|t }}</h2>
        <p>{{ 'A reviewer will confirm, change or remove these.'|t }}</p>
      </div>
      {% if view.findings %}{{ m.findings(view.findings, page.apps|length > 1) }}{% endif %}
    </section>
  {% endif %}

  {% if view.state == 'decided' %}
    {# Only each app's decision label and the next-step sentence: the rest of
       page.decision is the reviewer's. #}
    <section class="arv-contributor__decision arv-contributor__decision--{{ view.decision_key|default('none')|clean_class }}" aria-labelledby="arv-decision-h">
      <div class="arv-contributor__decision-text">
        <h2 id="arv-decision-h">{{ view.decision.label }}</h2>
        {% if view.decision_apps|length > 1 %}
          <ul class="arv-contributor__apps">
            {% for app in view.decision_apps %}<li>{{ app.name }}: {{ app.label }}</li>{% endfor %}
          </ul>
        {% endif %}
        {% if view.next_step %}<p>{{ view.next_step }}</p>{% endif %}
      </div>
      {# Re-submit posts to the existing send-for-review route, which checks
         the CSRF token in the URL and redirects to the hub. It is a plain
         form, not a Form API element, so it has no form token of its own. #}
      {% if view.resubmit %}
        <div class="arv-contributor__actions">
          <form method="post" action="{{ view.resubmit.url }}">
            <button type="submit" class="arv-contributor__resubmit">{{ 'Re-submit for review'|t }}</button>
          </form>
        </div>
      {% endif %}
    </section>

    {% if view.response %}
      <section class="arv-contributor__section" aria-labelledby="arv-response-h">
        <h2 id="arv-response-h">{{ 'Response from the reviewer'|t }}</h2>
        <div class="arv-contributor__response">{{ view.response }}</div>
      </section>
    {% endif %}

    {% if view.findings %}
      <section class="arv-contributor__section" aria-labelledby="arv-fix-h">
        <h2 id="arv-fix-h">{{ 'What to fix'|t }}</h2>
        {{ m.findings(view.findings, page.apps|length > 1) }}
      </section>
    {% endif %}

    <div class="arv-contributor__folds">
      {{ m.passed(view.passed) }}
      {% if form['#progress'] %}
        <details>
          <summary>{{ 'Progress'|t }}</summary>
          <div class="arv-contributor__progress">{{ form['#progress'] }}</div>
        </details>
      {% endif %}
      {% if page.history.others is not empty %}
        <details>
          <summary>{{ 'Earlier reviews (@n)'|t({'@n': page.history.others|length}) }}</summary>
          <ul class="arv-contributor__earlier">
            {% for other in page.history.others %}
              <li><a href="{{ other.url }}">{{ other.at }}</a>{% if other.decision %} <span aria-hidden="true" class="arv-contributor__dot">·</span> {{ other.decision }}{% endif %}</li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
    </div>
  {% endif %}

  {% if view.state == 'precheck' and view.passed %}
    <div class="arv-contributor__folds">{{ m.passed(view.passed) }}</div>
  {% endif %}
</div>
