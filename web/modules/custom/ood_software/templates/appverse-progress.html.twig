{#
/**
 * @file
 * A repo's review progress line (appverse-planning#31; mock
 * review-states-progress-steps.pdf, "Option B · chosen").
 *
 * Steps come from ReviewProgress::steps(): five for reviewers, four for
 * contributors. Each step's state is one of done, current (waiting on a
 * reviewer or the AI), waiting (on the contributor), failed (or declined),
 * not_reached.
 *
 * @var steps - list of {step, state, label}.
 * @var variant - 'steps': numbered circles with labels (review page header);
 *   'bar': thin segments with step names (hub card).
 * @var labels - whether the bar shows each step's label under its name.
 */
#}
{{ attach_library('ood_software/appverse_progress') }}
{% set state_text = {
  done: 'Done'|t,
  current: 'Current'|t,
  waiting: 'Waiting on the contributor'|t,
  failed: 'Failed or declined'|t,
  not_reached: 'Not reached'|t,
} %}
<ol class="arv-progress arv-progress--{{ variant }}" aria-label="{{ 'Review progress'|t }}">
  {% for s in steps %}
    <li class="arv-progress__step is-{{ s.state|clean_class }}"{% if s.state in ['current', 'waiting', 'failed'] %} aria-current="step"{% endif %}{% if s.label %} title="{{ s.label }}"{% endif %}>
      {% if variant == 'steps' %}
        <span class="arv-progress__dot" aria-hidden="true">{{ loop.index }}</span>
      {% else %}
        <span class="arv-progress__seg" aria-hidden="true"></span>
      {% endif %}
      <span class="arv-progress__name">{{ s.step|t }}</span>
      <span class="visually-hidden">: {{ state_text[s.state] }}</span>
      {# Two labels say nothing the step has not already said: one that repeats
         its step's name ("Submitted" under Submitted, "Live" under Live), and
         a bare "Done" on a step the circle already shows as done. Both are
         dropped from the line; the state is still announced to screen readers
         above, and the labels stay in the data because the card's chip reads
         them (appverse-planning#53). #}
      {% if s.label and s.label != s.step and not (s.state == 'done' and s.label == 'Done') and (variant == 'steps' or labels) %}
        <span class="arv-progress__label">{{ s.label }}</span>
      {% endif %}
      {# A monorepo whose apps were decided differently: the label above is the
         strictest of them, so name each app (appverse-planning#49). #}
      {% if s.apps is defined and s.apps is not empty and variant == 'steps' %}
        <span class="arv-progress__apps">
          {% for app, decision in s.apps %}
            <span class="arv-progress__app">{{ app }}: {{ decision }}</span>
          {% endfor %}
        </span>
      {% endif %}
    </li>
  {% endfor %}
</ol>
