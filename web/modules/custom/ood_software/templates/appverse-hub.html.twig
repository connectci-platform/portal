{#
/**
 * @file
 * Maintenance-hub card for one appverse_repo (views.view.my_appverse).
 *
 * @var hub - structured row data from _ood_software_build_hub_row().
 *
 * Header cluster, left→right:
 *   [status badge] | [pencil — inferred+can_edit] | Submitted <ts>
 *   | [github] | [catalog] | [owner name][email — admin]
 *   | [labelled actions + Actions menu]
 */
#}
{# The id is the anchor a card action returns to (see
   _ood_software_hub_action_form()), so the reviewer lands on this card. #}
<article id="appverse-repo-{{ hub.repo_id }}" class="appverse-hub-card state-{{ hub.moderation_state }}">
  {# Header is a CSS grid with shared column tracks so fields line up across
     cards: title | submitted | github | owner | status | actions.
     Status sits in its own column next to the actions so it always lines up.
     Each cell always renders (even when empty) to preserve column alignment. #}
  <header class="appverse-hub-card__header">
    <h3 class="appverse-hub-card__title appverse-hub-card__cell--title">
      {# Only published repos appear in the catalog, so don't link to it when
         this repo isn't visible there. #}
      {% if hub.published %}
        <a href="{{ hub.catalog_url }}">{{ hub.title }}</a>
      {% else %}
        {{ hub.title }}
      {% endif %}
    </h3>

    <div class="appverse-hub-card__cell appverse-hub-card__cell--submitted">
      {% if hub.submitted %}
        <span class="appverse-hub-card__submitted">{{ 'Submitted'|t }} {{ hub.submitted }}</span>
      {% endif %}
    </div>

    {# The card title links to the catalog, so a separate catalog icon would be
       redundant. GitHub is the only remaining header link here. #}
    <div class="appverse-hub-card__cell appverse-hub-card__cell--github">
      {% if hub.github_url %}
        <a href="{{ hub.github_url }}" class="appverse-hub-card__icon-btn" target="_blank" rel="noopener"
           title="{{ 'View on GitHub'|t }}" aria-label="{{ 'View @t on GitHub'|t({'@t': hub.title}) }}">
          <i class="bi bi-github" aria-hidden="true"></i>
        </a>
      {% endif %}
    </div>

    {# Owner name + contact only when the repo is owned by someone else (the
       row builder sets hub.owner to null when the viewer owns it). On your own
       apps the owner is you, so it's redundant noise. The grid column track
       stays (empty) when there's no owner so cards stay aligned. #}
    <div class="appverse-hub-card__cell appverse-hub-card__cell--owner">
      {% if hub.owner %}
        <a href="{{ hub.owner.persona_url }}" class="appverse-hub-card__owner">{{ hub.owner.name }}</a>
        {% if hub.owner.email %}
          <a href="mailto:{{ hub.owner.email }}" class="appverse-hub-card__icon-btn"
             title="{{ 'Email @n'|t({'@n': hub.owner.name}) }}" aria-label="{{ 'Email @n'|t({'@n': hub.owner.name}) }}">
            <i class="bi bi-envelope" aria-hidden="true"></i>
          </a>
        {% endif %}
      {% endif %}
    </div>

    <div class="appverse-hub-card__cell appverse-hub-card__cell--status">
      {# Where the repo is in review is the progress line below the header
         (appverse-planning#31); these badges are what it does not show. #}
      {% if hub.unpublished_after_publish %}
        <span class="badge badge-warning badge--hint" title="{{ 'Was published, then unpublished. Only an admin can republish it.'|t }}">{{ hub.is_admin ? 'Unpublished'|t : 'Unpublished — admin must republish'|t }}</span>
      {% elseif hub.moderation_state == 'archived' %}
        <span class="badge badge-{{ hub.status.modifier }} badge--hint" title="{{ hub.status.description }}">{{ hub.status.label }}</span>
      {% endif %}
      {% if hub.has_validation_issues %}
        <span class="badge badge-error badge--hint" title="{{ 'The last sync found problems in appverse.yml or the app files; see the edit page.'|t }}">{{ 'Validation errors'|t }}</span>
      {% endif %}
    </div>

    {# Actions. A reviewer can have six of these at once, which never fit the
       column and wrapped onto a second row over the line below. Icons alone
       also did not say what they do: a tooltip can confirm a guess but cannot
       advertise a capability, so the play icon stayed unreadable however many
       titles it carried (appverse-planning#55).

       So: the one or two a reviewer uses on most rows stay out as labelled
       buttons, and the rest go in a menu where every item is named in words.
       A contributor has at most three and keeps them all inline, which is why
       the menu is built only when there is something to put in it. Delete sits
       last behind a separator, away from the benign actions it used to sit
       beside. Bootstrap 4 is global in the ood theme (data-toggle, not
       data-bs-toggle) so this needs no JS of its own. #}
    <div class="appverse-hub-card__cell appverse-hub-card__cell--actions">
      {# Exactly one action stays inline, and everything else is in the menu.
         Named actions are much wider than the icons they replace, and the
         column is 13rem: two of them plus the menu button overflow it and wrap
         onto the progress line below, which is the problem this replaced.

         Which one is inline is the one thing the card most expects you to do
         next: open the review if there is one, otherwise run the report (a
         reviewer), or send for review (a contributor). The row builder decides
         that; see hub.primary_action. #}
      {% if hub.primary_action %}{{ hub.primary_action }}{% endif %}

      {% if hub.has_menu %}
        <div class="dropdown appverse-hub-card__menu">
          <button class="appverse-hub-card__action-btn dropdown-toggle" type="button"
                  id="appverse-actions-{{ hub.repo_id }}" data-toggle="dropdown"
                  aria-haspopup="true" aria-expanded="false"
                  aria-label="{{ 'More actions for @t'|t({'@t': hub.title}) }}">
            {{ 'Actions'|t }}
          </button>
          <div class="dropdown-menu dropdown-menu-right" aria-labelledby="appverse-actions-{{ hub.repo_id }}">
            {% if hub.review.review_url and hub.review.run_review_action %}
              {{ hub.review.run_review_action_menu }}
            {% endif %}
            {# In the menu only when it is not the inline action, i.e. when a
               review already exists and took that slot. #}
            {% if hub.actions.send_for_review and hub.review.review_url %}{{ hub.actions.send_for_review }}{% endif %}
            {% if hub.edit_url %}
              <a class="dropdown-item" href="{{ hub.edit_url }}">
                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit'|t }}
              </a>
            {% endif %}
            {% if hub.actions.resync %}{{ hub.actions.resync }}{% endif %}
            {% if hub.actions.withdraw %}{{ hub.actions.withdraw }}{% endif %}
            {% if hub.actions.assign %}{{ hub.actions.assign }}{% endif %}
            {% if hub.actions.request_changes %}
              <a class="dropdown-item" href="{{ hub.actions.request_changes.url }}">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i> {{ 'Request changes'|t }}
              </a>
            {% endif %}
            {% if hub.actions.publish %}{{ hub.actions.publish }}{% endif %}
            {% if hub.actions.unpublish %}{{ hub.actions.unpublish }}{% endif %}
            {% if hub.actions.delete %}
              <div class="dropdown-divider"></div>
              <a class="dropdown-item appverse-hub-card__menu-item--danger" href="{{ hub.actions.delete.url }}">
                <i class="bi bi-trash" aria-hidden="true"></i> {{ 'Delete'|t }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </header>

  {# Where the repo is, in one chip. The full five-step line is a lot to scan
     down a list, so it lives on the review page and the card carries this
     (appverse-planning#55). Contributors keep their sentence, which says what
     to do next when it is their turn. #}
  <div class="appverse-hub-card__progress">
    <span class="badge badge-{{ hub.progress_chip.modifier }} appverse-hub-card__progress-chip">{{ hub.progress_chip.label }}</span>
    {% if hub.progress_sentence %}
      <p class="appverse-hub-card__progress-sentence">{{ hub.progress_sentence }}</p>
    {% endif %}
    {% if hub.assignee is not null %}
      <p class="appverse-hub-card__assignee">
        <i class="bi bi-person" aria-hidden="true"></i>
        {{ 'Reviewer:'|t }} {{ hub.assignee ?: 'Unassigned'|t }}
      </p>
    {% endif %}
  </div>

  {# Repo-level discovery tags (shared `tags` vocab), on their own full-width
     row below the header so they wrap freely and don't compete with the
     header's fixed grid (which would shove the action icons to a second row).
     Resolved tags are quiet neutral chips; unresolved ones read as warnings. #}
  {% if hub.discovery_tags.resolved or hub.discovery_tags.unresolved %}
    <div class="appverse-hub-card__tags" role="list" aria-label="{{ 'Repository tags'|t }}">
      <span class="appverse-hub-card__tags-label">{{ 'Tags:'|t }}</span>
      {% for tag in hub.discovery_tags.resolved %}
        <span class="appverse-tag appverse-tag--resolved" role="listitem">{{ tag }}</span>
      {% endfor %}
      {% for tag in hub.discovery_tags.unresolved %}
        <span class="appverse-tag appverse-tag--unresolved" role="listitem"
              title="{{ 'Not a catalog tag — not applied. Contributor should use an existing tag in appverse.yml.'|t }}">
          <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {{ tag }}
        </span>
      {% endfor %}
    </div>
  {% endif %}

  {# Single-app repos have no apps table, so show the one app's implementation
     tags here on the card. (Monorepos show per-app tags in the apps table
     below instead; hub.single_app_tags is null for them.) #}
  {% if hub.single_app_tags and (hub.single_app_tags.resolved or hub.single_app_tags.unresolved) %}
    <div class="appverse-hub-card__tags" role="list" aria-label="{{ 'Implementation tags'|t }}">
      <span class="appverse-hub-card__tags-label">{{ 'Implementation:'|t }}</span>
      {% for tag in hub.single_app_tags.resolved_shown %}
        <span class="appverse-tag appverse-tag--resolved" role="listitem">{{ tag }}</span>
      {% endfor %}
      {% if hub.single_app_tags.truncated %}
        <span class="appverse-tag appverse-tag--more" role="listitem"
              title="{{ '@count more tags'|t({'@count': hub.single_app_tags.remaining}) }}">
          +{{ hub.single_app_tags.remaining }} {{ 'more'|t }}
        </span>
      {% endif %}
      {% for item in hub.single_app_tags.unresolved %}
        <span class="appverse-tag appverse-tag--unresolved" role="listitem"
              title="{{ item.create_url ? 'Not in the vocabulary yet — click to create this tag.'|t : 'Not in the vocabulary — an admin can add it.'|t }}">
          <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
          {% if item.create_url %}<a href="{{ item.create_url }}">{{ item.declared }}</a>{% else %}{{ item.declared }}{% endif %}
        </span>
      {% endfor %}
    </div>
  {% endif %}

  {% if hub.moderation_state == 'needs_adjustment' and hub.moderation_comment %}
    <div class="appverse-hub-card__moderation-comment">
      <strong>{{ 'Admin feedback:'|t }}</strong>
      <p>{{ hub.moderation_comment }}</p>
    </div>
  {% endif %}

  {% if hub.is_monorepo %}
    <details class="appverse-hub-card__apps">
      <summary>
        <i class="bi bi-chevron-right appverse-hub-card__apps-chevron" aria-hidden="true"></i>
        {{ '@count apps'|t({'@count': hub.app_count}) }}
      </summary>
      <table class="appverse-hub-apps-table">
        <thead>
          <tr>
            <th>{{ 'App'|t }}</th>
            <th>{{ 'Subpath'|t }}</th>
            <th>{{ 'Software'|t }}</th>
            <th>{{ 'Implementation'|t }}</th>
            <th>{{ 'Status'|t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for app in hub.apps %}
            <tr>
              <td>
                {# Link to the catalog only when the app is actually visible
                   there: both the app and its parent repo must be published. #}
                {% if hub.published and app.published %}
                  <a href="{{ app.catalog_url }}">{{ app.title }}</a>
                {% else %}
                  {{ app.title }}
                {% endif %}
              </td>
              <td><code>{{ app.subpath ?: '.' }}</code></td>
              <td>{{ app.software ?: '—' }}</td>
              <td class="appverse-hub-apps-table__tags">
                {# Resolved implementation tags — first N chips, then "+M more". #}
                {% for tag in app.tags.resolved_shown %}
                  <span class="appverse-tag appverse-tag--resolved">{{ tag }}</span>
                {% endfor %}
                {% if app.tags.truncated %}
                  <span class="appverse-tag appverse-tag--more"
                        title="{{ '@count more tags'|t({'@count': app.tags.remaining}) }}">
                    +{{ app.tags.remaining }} {{ 'more'|t }}
                  </span>
                {% endif %}
                {# Unresolved tags — always shown in full, with a create-term link. #}
                {% for item in app.tags.unresolved %}
                  {% if item.create_url %}
                    <a href="{{ item.create_url }}"
                       class="appverse-tag appverse-tag--unresolved"
                       title="{{ 'Not in the vocabulary yet — click to create this tag.'|t }}">
                      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {{ item.declared }}
                    </a>
                  {% else %}
                    <span class="appverse-tag appverse-tag--unresolved"
                          title="{{ 'Not in the vocabulary — an admin can add it.'|t }}">
                      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> {{ item.declared }}
                    </span>
                  {% endif %}
                {% endfor %}
              </td>
              <td>
                <span class="badge badge-{{ app.status.modifier }}{{ app.status.description ? ' badge--hint' }}" {% if app.status.description %}title="{{ app.status.description }}"{% endif %}>{{ app.status.label }}</span>
                {% if app.edit_url %}
                  <a href="{{ app.edit_url }}" class="appverse-hub-card__icon-btn"
                     title="{{ 'Edit'|t }}" aria-label="{{ 'Edit @t'|t({'@t': app.title}) }}">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                  </a>
                {% endif %}
                {% if app.unpublish_form %}{{ app.unpublish_form }}{% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
  {% endif %}
</article>
