{#
/**
 * @file
 * The public summary of a review: what a visitor sees.
 *
 * Same data as appverse-review-form (form['#page']), fewer details: the
 * decision, one section per category, and the reviewer's published
 * assessment. No response to the contributor, no internal notes, no links to
 * the private report files. form['#preview'] is set when a reviewer is
 * looking at this view rather than a visitor.
 *
 * The repo owner gets the same page with a band of their own above the report
 * (D8-3091): form['#contributor_view'] is what ContributorReviewView::build()
 * returns, plus next_step, decision_apps, decision_key and resubmit (NULL, or
 * {url} of the CSRF-tokened send-for-review route). Before the decision is
 * sent, form['#page'] holds the tool's report alone. Only each app's decision
 * label of page.decision is printed; its reviewer-only parts (publish_url,
 * update_blocker, waiting_on, email) never are.
 */
#}
{% set page = form['#page'] %}
{% set view = form['#contributor_view'] ?? null %}
{# The wireframe's dot classes rate quality: level-high is the good end (solid
   green), level-low the poor end (red ring). #}
{% set level_class = {'solid': 'high', 'some_notes': 'medium', 'needs_attention': 'low'} %}

{# One category: its heading, rating and one-line summary, then its findings,
   read-only (rule, severity, summary, evidence). The owner's findings start
   open and carry the reviewer's note to them; visitors see no notes. #}
{# The id matches the reviewer page's block ids (block-<app id>-<category>, or
   block-<category> for the repository's), so one link from the catalog's
   chips works on either page (D8-2928). #}
{% macro summary_row(block, page, level_class, scope, owner) %}
  {% set n = 0 %}
  {% for group in block.groups %}{% set n = n + group.count %}{% endfor %}
  <section class="summary-row" id="block-{{ scope ? scope ~ '-' : '' }}{{ block.key }}">
    <h3 class="summary-row-title">{{ block.title }}</h3>
    <div class="summary-row-head">
      {% if block.level %}
        <span class="rating-badge"><span class="rating-dot level-{{ level_class[block.level] ?? 'none' }}"></span><span class="rating-label">{{ (page.level_labels[block.key] ?? {})[block.level] ?? block.level }}</span></span>
      {% endif %}
      <span class="summary-line">{{ block.summary ?: block.count_line }}</span>
    </div>
    {# A re-rated category says so, as a re-rated finding does: the line beside
       the badge is the tool's, written for its own rating. The reason is a
       note to the owner. #}
    {% if block.level and block.tool_level and block.level != block.tool_level %}
      {% set tool_label = (page.level_labels[block.key] ?? {})[block.tool_level] ?? block.tool_level %}
      <div class="override-mark">{{ 'Reviewer changed the rating from @level'|t({'@level': tool_label}) }}</div>
      {% if owner and block.note %}<div class="finding-note">{{ 'Note from the reviewer: @note'|t({'@note': block.note}) }}</div>{% endif %}
    {% endif %}
    {% if n > 0 %}
      {# The owner's list starts open, so its label names it rather than
         offering to show it. #}
      <details class="summary-findings"{{ owner ? ' open' }}>
        {% if owner %}
          <summary>{{ n == 1 ? '1 finding'|t : '@n findings'|t({'@n': n}) }}</summary>
        {% else %}
          <summary>{{ n == 1 ? 'Show 1 finding'|t : 'Show @n findings'|t({'@n': n}) }}</summary>
        {% endif %}
        {% for group in block.groups %}
          <div class="summary-sev">{{ group.severity|capitalize }} <span class="n">({{ group.count }})</span></div>
          {% for finding in group.findings %}
            <div class="frow">
              {% if finding.rule %}<div class="rule">{{ finding.rule }}</div>{% endif %}
              <div>
                <div class="sum">{{ finding.summary }}{% if finding.source == 'reviewer' %} <span class="reviewer-tag">{{ 'Reviewer'|t }}</span>{% endif %}{% if finding.override and finding.override.edited %} <span class="finding-edited">{{ 'Edited by the reviewer'|t }}</span>{% endif %}</div>
                {# A re-rated finding says so (A1); the reason is a note, which only the owner sees. Dismissed
                   findings are not in the groups, so never shown here. #}
                {% if finding.override and finding.override.severity %}<div class="override-mark">{{ 'Reviewer changed the severity from @severity'|t({'@severity': finding.tool_severity|capitalize}) }}</div>{% endif %}
                {% if owner and finding.prose %}<div class="finding-note">{{ 'Note from the reviewer: @note'|t({'@note': finding.prose}) }}</div>{% endif %}
                {% if finding.evidence %}<div class="ev">{% for part in finding.evidence_parts %}{% if part.url %}<a href="{{ part.url }}" target="_blank" rel="noopener" title="{{ 'View on GitHub at the reviewed commit'|t }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</div>{% endif %}
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </details>
    {% endif %}
  </section>
{% endmacro %}
{% import _self as m %}

<div class="arv-page arv-summary{{ view ? ' arv-summary--owner' }}">
  {% if form['#preview'] %}
    <div class="arv-preview-banner">
      {{ 'Preview: this is what visitors see.'|t }}
      <a href="{{ page.full_url }}">{{ 'Back to the full review'|t }}</a>
    </div>
  {% endif %}

  {% if page.superseded_by %}
    <div class="arv-superseded">
      {{ 'A newer review of this repo exists'|t }} ({{ page.superseded_by.label }}).
      <a href="{{ page.superseded_by.url }}">{{ 'Go to the newer review'|t }} ›</a>
    </div>
  {% elseif view and view.closed == 'withdrawn' %}
    <div class="arv-superseded">{{ 'This repo was withdrawn from review.'|t }}</div>
  {% endif %}

  <div class="overview-block">
    <div class="overview-row">
      {# The reviewer page's header lines, for visitors: the app, what was
         reviewed, then this review. No "Submitted by", no links out, no
         rerun note. #}
      <div class="overview-meta">
        <h2 class="overview-title">{{ page.title }}</h2>
        <div class="overview-line overview-facts">
          {% if page.repo_url %}
            <span>{{ page.repo_url|replace({'https://': '', 'http://': '', 'github.com/': ''}) }}</span>
          {% endif %}
          {% if page.show_maintainer %}
            <span class="overview-sep" aria-hidden="true">·</span>
            {{ 'Maintained by @m'|t({'@m': page.maintainer}) }}
          {% endif %}
          {% if page.shape %}
            <span class="overview-sep" aria-hidden="true">·</span>
            {{ page.shape }}
          {% endif %}
        </div>
        <div class="overview-line overview-line--sub">
          <code>{{ page.sha7 }}</code>{% if page.ref and page.ref != page.sha %} {{ 'on'|t }} <code>{{ page.ref }}</code>{% endif %}
          {% if page.reviewed_at %}<span class="overview-sep" aria-hidden="true">·</span>{{ page.reviewed_at }}{% endif %}
          <span class="overview-sep" aria-hidden="true">·</span>
          {% if page.history and page.history.total > 1 %}
            <b>{{ 'Review @n of @total'|t({'@n': page.history.position, '@total': page.history.total}) }}</b>
          {% else %}
            {{ 'First review of this repo'|t }}
          {% endif %}
        </div>
      </div>
      {% if page.history and page.history.total > 1 and (page.history.older or page.history.newer) %}
        <div class="prev-reviews review-history">
          {% if page.history.older %}<a href="{{ page.history.older.url }}">‹ {{ 'Older'|t }}</a>{% endif %}
          {% if page.history.older and page.history.newer %}·{% endif %}
          {% if page.history.newer %}<a href="{{ page.history.newer.url }}">{{ 'Newer'|t }} ›</a>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if view %}
    {# The owner's band: only the repo owner gets it. #}
    <div class="arv-contributor arv-owner-band">
      {% if view.state == 'decided' %}
        <section class="arv-contributor__decision arv-contributor__decision--{{ view.decision_key|default('none')|clean_class }}" aria-labelledby="arv-decision-h">
          <div class="arv-contributor__decision-text">
            <h2 id="arv-decision-h">{{ view.decision.label }}</h2>
            {% if view.decision_apps|length > 1 %}
              <ul class="arv-contributor__apps">
                {% for app in view.decision_apps %}<li>{{ app.name }}: {{ app.label }}</li>{% endfor %}
              </ul>
            {% endif %}
            {% if view.next_step %}<p>{{ view.next_step }}</p>{% endif %}
            {% if page.decision.by %}<p class="arv-contributor__meta">{{ 'Reviewed by @name, @date'|t({'@name': page.decision.by, '@date': page.decision.at}) }}</p>{% endif %}
          </div>
          {# Re-submit posts to the existing send-for-review route, which checks
             the CSRF token in the URL and redirects to the hub. It is a plain
             form, not a Form API element, so it has no form token of its own. #}
          {% if view.resubmit %}
            <div class="arv-contributor__actions">
              <form method="post" action="{{ view.resubmit.url }}">
                <button type="submit" class="arv-contributor__resubmit">{{ 'Re-submit for review'|t }}</button>
              </form>
            </div>
          {% endif %}
        </section>
        {% if view.response %}
          <section class="arv-contributor__section" aria-labelledby="arv-response-h">
            <h2 id="arv-response-h">{{ 'Response from the reviewer'|t }}</h2>
            <div class="arv-contributor__response">{{ view.response }}</div>
          </section>
        {% endif %}
      {% else %}
        <section class="arv-contributor__section" aria-labelledby="arv-status-h">
          <div class="arv-contributor__heading">
            <h2 id="arv-status-h">{{ view.state == 'precheck' ? 'Automated check'|t : 'Waiting for the automated check'|t }}</h2>
            {% if view.state == 'precheck' %}<p>{{ 'Below is what the automated check found. A reviewer will confirm, change or remove these before sending a decision.'|t }}</p>{% endif %}
            {% if view.next_step %}<p>{{ view.next_step }}</p>{% endif %}
          </div>
        </section>
      {% endif %}
      {% if form['#progress'] %}<div class="arv-contributor__progress">{{ form['#progress'] }}</div>{% endif %}
    </div>
  {% endif %}

  {# Before the automated check has run, the owner has the band alone. #}
  {% if not view or view.state != 'waiting' %}
    {% if page.assessment %}
      <section class="summary-assessment">
        <h2 class="sec">{{ 'Summary'|t }}</h2>
        <div class="arv-text">{{ page.assessment }}</div>
      </section>
    {% endif %}

    {% for app in page.apps %}
      <section class="summary-app" id="app-{{ app.app_id }}">
        <div class="summary-app-head">
          <h2 class="sec app-name">{{ app.name }}</h2>
          {% if app.conclusion %}
            <span class="decision-pill decision-pill--{{ app.conclusion }}">{{ page.conclusion_labels[app.conclusion] ?? app.conclusion }}</span>
          {% else %}
            <span class="decision-pill">{{ 'Not decided'|t }}</span>
          {% endif %}
        </div>
        <div class="summary-rows">
          {% for key, block in app.blocks %}
            {{ m.summary_row(block, page, level_class, app.app_id, view is not null) }}
          {% endfor %}
        </div>
      </section>
    {% endfor %}

    {# Repo-wide findings (a monorepo files these under the repo, not an app)
       and the Maintenance block. #}
    <section class="summary-app" id="maintenance">
      <div class="summary-app-head"><h2 class="sec app-name">{{ 'Repository'|t }}</h2></div>
      <div class="summary-rows">
        {% for key, block in page.repo_blocks %}
          {# A repo block of only PASS / NOT CHECKED rows has nothing for a
             visitor; reviewers see those rows on the full page. #}
          {% if block.groups is not empty %}
            {{ m.summary_row(block, page, level_class, null, view is not null) }}
          {% endif %}
        {% endfor %}
        {{ m.summary_row(page.maintenance, page, level_class, null, view is not null) }}
      </div>
    </section>

    {% if page.tool_version %}
      <p class="arv-footnote">{{ 'Report produced by @tool'|t({'@tool': page.tool_version}) }}</p>
    {% endif %}

    <p class="summary-disclaimer">{{ 'This is an automated review with human curation. It is provided without warranty of any kind and does not certify the app as secure or fit for any purpose. A listing is not an endorsement.'|t }}</p>
  {% endif %}

  {{ form|without('page', 'can_edit', 'preview') }}
</div>
