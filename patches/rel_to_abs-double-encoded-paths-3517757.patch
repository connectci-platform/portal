+  /**
+   * Ensures already-encoded paths are not encoded a second time.
+   */
+  public function testRelToAbsFilterEncodedPaths() {
+    $language = \Drupal::getContainer()
+      ->get('language_manager')
+      ->getLanguage(LanguageInterface::LANGCODE_NOT_SPECIFIED);
+
+    $front = rtrim(Url::fromRoute('<front>', [], [
+      'absolute' => TRUE,
+      'language' => $language,
+    ])->toString(), '/');
+
+    $filter = new RelToAbs([], 'rel_to_abs', ['provider' => 'rel_to_abs']);
+
+    $cases = [
+      // Spaces, literal percent signs and multibyte characters in the path.
+      '/files/a%20b.jpg' => '/files/a%20b.jpg',
+      '/files/100%25.jpg' => '/files/100%25.jpg',
+      '/files/caf%C3%A9.jpg' => '/files/caf%C3%A9.jpg',
+      // Unencoded input is still encoded once.
+      '/files/a b.jpg' => '/files/a%20b.jpg',
+      // Encoded query and fragment values are left as-is.
+      '/node/1?q=a%26b' => '/node/1?q=a%26b',
+      '/node/1#sec%20one' => '/node/1#sec%20one',
+    ];
+    foreach ($cases as $input => $expected) {
+      $result = $filter->process('<img src="' . $input . '"/>', NULL);
+      $this->assertEquals('<img src="' . $front . $expected . '"/>', (string) $result, $input);
+    }
+  }
+
 }
